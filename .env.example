# ============================================
# Padel@Home - Variables de entorno (Vercel + Supabase)
# Copia este fichero a .env para desarrollo local.
# En Vercel, configura las mismas variables en Project Settings > Environment Variables.
# ============================================

# --- Servidor ---
PORT=3000

# --- Base de datos Supabase (PostgreSQL) ---
# Transaction pooler IPv4 de Supabase (región eu-west-1, verificado). Necesario en Vercel
# porque el host directo db.* solo resuelve IPv6, y el TRANSACTION pooler (6543)
# multiplexa conexiones (el session pooler 5432 solo admite 15 clientes simultáneos).
DATABASE_URL=postgresql://postgres.nminghnjetilraumekeq:YOUR_SUPABASE_DB_PASSWORD@aws-0-eu-west-1.pooler.supabase.com:6543/postgres

# --- Autenticación ---
# IMPORTANTE: entre comillas, porque el secreto original contiene el carácter '#'
# (dotenv lo interpretaría como comentario y lo truncaría).
# En Vercel pega el valor SIN comillas.
JWT_SECRET="T58LTAtPXh!WoycBa$9gZ5YFG63&Py@U@n7^f74p!%mpg#8RFYm3Z%W"

# --- Secreto para los endpoints de cron (/api/cron/*) ---
# Genera uno nuevo: openssl rand -hex 32
CRON_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=nassabadell01@gmail.com
SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
SMTP_FROM_NAME=Padel@Home

# --- URL pública de la aplicación (para los enlaces de los correos) ---
APP_URL=https://padelathome.wincicloud.win

# --- Notificaciones push (Web Push / VAPID) ---
# Genera las claves con: npx web-push generate-vapid-keys
# La clave pública se sirve al navegador en GET /api/push/config (no es secreta).
VAPID_PUBLIC_KEY=CHANGE_ME_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=CHANGE_ME_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:nassabadell01@gmail.com

# --- Zona horaria ---
TZ=Europe/Madrid
