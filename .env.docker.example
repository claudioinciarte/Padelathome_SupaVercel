# ============================================================
# Padel@Home - Variables para el modo Docker (Postgres local)
# Copia a .env y rellena los valores reales.
#   cp .env.docker.example .env
# ============================================================

# --- Postgres local (servicio db del compose) ---
# Solo la contraseña local; usuario y BD los fija el compose (padel/padelathome)
POSTGRES_PASSWORD=cambia_esta_password_local

# --- Secretos de la app (OBLIGATORIO generar nuevos) ---
# Genera con: openssl rand -hex 32
JWT_SECRET=
CRON_SECRET=

# --- Email (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Padel@Home

# --- URL pública de la app (para enlaces en correos) ---
# Si la expones en la red local: http://<IP-de-tu-maquina>:3000
APP_URL=http://localhost:3000

# --- Notificaciones push (Web Push / VAPID) ---
# Genera con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# --- Zona horaria ---
TZ=Europe/Madrid

# --- Puerto del host para la app (opcional) ---
APP_PORT=3000
